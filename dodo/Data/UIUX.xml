<?xml version="1.0" encoding="utf-8"?>
<Ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.blizzard.com/wow/ui/" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
    <!-- Settings 컨트롤 템플릿 -->
    <CheckButton name="dodoCheckboxTemplate" inherits="SettingsCheckboxControlTemplate" virtual="true"/>
    <Frame name="dodoDropdownTemplate" inherits="SettingsDropDownControlTemplate" virtual="true"/>
    <Slider name="dodoSliderTemplate" inherits="SettingsSliderControlTemplate" virtual="true"/>
    <Frame name="dodoCheckboxDropdownTemplate" inherits="SettingsCheckBoxDropDownControlTemplate" virtual="true"/>
    <Frame name="dodoCheckboxSliderTemplate" inherits="SettingsCheckBoxSliderControlTemplate" virtual="true"/>
    <Frame name="dodoColorRowTemplate" inherits="SettingsColorSwatchControlTemplate" virtual="true"/>
    <Frame name="dodoMultiDropDownTemplate" virtual="true">
        <Size y="32"/>
        <Scripts>
            <OnLoad>if dodoMultiDropDownMixin then Mixin(self, dodoMultiDropDownMixin) end</OnLoad>
        </Scripts>
    </Frame>
    <!-- 단순 미리보기 프레임 (탭 없음) -->
    <Frame name="dodoPreviewTemplate" virtual="true">
        <Size y="66"/>
        <Scripts>
            <OnShow>if self.Update then self:Update() end</OnShow>
        </Scripts>
    </Frame>
    <!-- 탭+테두리 미리보기 프레임 (탭은 Lua에서 동적 생성) -->
    <Frame name="dodoTabbedPreviewTemplate" virtual="true">
        <Size y="66"/>
        <Layers>
            <Layer level="OVERLAY">
                <FontString parentKey="PreviewLabel" inherits="GameFontHighlightSmall" text="미리보기">
                    <Anchors>
                        <Anchor point="LEFT" relativePoint="TOPLEFT" x="14" y="-30"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Frame parentKey="NineSlice" inherits="NineSlicePanelTemplate">
                <KeyValues>
                    <KeyValue key="layoutType" value="UniqueCornersLayout" type="string"/>
                    <KeyValue key="layoutTextureKit" value="OptionsFrame" type="string"/>
                </KeyValues>
                <Anchors>
                    <Anchor point="TOPLEFT" x="0" y="-32"/>
                    <Anchor point="BOTTOMRIGHT" x="0" y="0"/>
                </Anchors>
            </Frame>
        </Frames>
        <Scripts>
            <OnShow>if self.Update then self:Update() end</OnShow>
        </Scripts>
    </Frame>
</Ui>
